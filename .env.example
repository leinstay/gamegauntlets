# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Loaded by src/config.js — a plain KEY=VALUE parser (quotes and # comments
# supported), not the "dotenv" package. Values already present in the real
# process environment (e.g. set by systemd) are never overridden by this file.

# MariaDB connection for the new `gg` schema (src/db.js).
DB_HOST=localhost
# Optional, defaults to 3306 (local dev uses the portable MariaDB on 3307).
DB_PORT=3306
DB_NAME=gg
DB_USER=
DB_PASSWORD=

# Redis connection for BullMQ queues (src/queue.js).
REDIS_URL=redis://127.0.0.1:6379

# Fastify API server port (src/api.js).
PORT=3000

# Secret used to sign the gg_session cookie (HMAC-SHA256). Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=

# Origin the frontend is served from; used for the same-origin/CSRF check on
# state-changing API requests.
PUBLIC_ORIGIN=https://gamegauntlets.com

# Steam Web API key (api.steampowered.com / store.steampowered.com): catalog,
# appdetails, prices, OpenID login verification.
STEAM_API_KEY=

# Twitch OAuth client id/secret used to fetch an IGDB API token.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Copied browser session cookie sent to gamefaqs.gamespot.com when scraping.
GAMEFAQS_COOKIE=


# src/worker.js: which source workers this process starts (see
# src/lib/worker-sources.js). At most one of these two — if both are set,
# WORKER_SOURCES wins and a warning is logged. Leave both unset to run every
# registered source (today's default).
#   WORKER_SOURCES=gamefaqs          # run ONLY these sources (comma-separated);
#                                     # no resolve/maintenance worker, no
#                                     # discover scheduling — for a standalone
#                                     # satellite.
#   WORKER_EXCLUDE_SOURCES=gamefaqs  # run every source EXCEPT these; resolve,
#                                     # maintenance and discover scheduling for
#                                     # ALL sources (including excluded ones)
#                                     # stay on.
WORKER_SOURCES=
WORKER_EXCLUDE_SOURCES=
